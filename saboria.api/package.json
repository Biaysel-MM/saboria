    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
