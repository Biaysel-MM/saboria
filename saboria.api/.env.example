# Copiar a .env y completar con valores reales. Nunca versionar .env.

# MySQL local (XAMPP)
DATABASE_URL="mysql://root@localhost:3306/saboria?connectionLimit=5&charset=utf8mb4"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# URL del frontend en desarrollo (Vite). Se usa para CORS.
CLIENT_URL="http://localhost:5173"

PORT=3002

# Correo (opcional). Si SMTP_HOST no está definido, los códigos de
# verificación se imprimen en la consola del backend (modo desarrollo).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Saboria <no-reply@saboria.do>"
